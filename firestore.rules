rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── sellers ──
    // Read: terbuka untuk semua (termasuk yang belum login, karena pembeli bisa browsing tanpa akun)
    // Write: hanya pemilik dokumen sendiri
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == sellerId;
      allow update: if request.auth != null && request.auth.uid == sellerId;
      allow delete: if false; // Tidak boleh hapus profil lewat client
    }

    // ── buyers ──
    // Read/Write: hanya pemilik dokumen sendiri
    match /buyers/{buyerId} {
      allow read, write: if request.auth != null && request.auth.uid == buyerId;
    }

    // ── follows ──
    // Read/Write: hanya jika auth.uid == buyerId pada dokumen tersebut
    match /follows/{followId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.buyerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.buyerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.buyerId;
      allow update: if false; // Follow docs tidak perlu di-update, hanya create/delete
    }

    // ── pendingNotifications ──
    // Created by sellers when toggling "Buka", read by GitHub Actions cron
    match /pendingNotifications/{notifId} {
      allow create: if request.auth != null;
      allow read: if false; // Only read by Admin SDK (server-side)
      allow update, delete: if false; // Only modified by Admin SDK
    }
  }
}
